# CoMpaNeoN AI Environment Configuration

# PostgreSQL / Neon database URL
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/companion_db

# Secret key for JWT token signing (change this!)
SECRET_KEY=your-secret-key-here

# Public API key for external access (optional, if using public endpoints)
PUBLIC_API_KEY=your-public-api-key

# GNews API key for news research (optional)
GNEWS_API_KEY=

# Host and port for the server
HOST=0.0.0.0
PORT=8000